<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.MovieSourcesFragment"
    android:background="?attr/colorPrimary"
    android:id="@+id/movie_sources_fragment">

    <include
        android:id="@+id/sourcesProgressCircle"
        layout="@layout/progressbar_circle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

   <!-- <ListView
        android:id="@+id/sourcesListView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />-->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/sourcesRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        tools:listitem="@layout/cardview_series" />
</FrameLayout>